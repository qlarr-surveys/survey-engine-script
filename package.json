{
  "name": "@qlarr/survey-engine-script",
  "version": "0.2.1",
  "description": "Validates the dynamic instruction scripts used in Qlarr survey designs. Parses each instruction to an AST (via acorn) and enforces a strict allowlist of permitted nodes, identifiers, properties, and methods.",
  "keywords": [
    "qlarr",
    "survey",
    "ast",
    "acorn",
    "validation",
    "sandbox",
    "expression"
  ],
  "license": "MIT",
  "author": "Amr Askoura",
  "homepage": "https://github.com/qlarr-surveys/survey-engine-script#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qlarr-surveys/survey-engine-script.git"
  },
  "bugs": {
    "url": "https://github.com/qlarr-surveys/survey-engine-script/issues"
  },
  "main": "dist/survey-engine-script.min.js",
  "module": "dist/survey-engine-script.esm.mjs",
  "unpkg": "dist/survey-engine-script.min.js",
  "exports": {
    ".": {
      "import": "./dist/survey-engine-script.esm.mjs",
      "require": "./dist/survey-engine-script.min.js",
      "default": "./dist/survey-engine-script.min.js"
    },
    "./dist/survey-engine-script.min.js": "./dist/survey-engine-script.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "acorn": "^8.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "rollup": "^4.20.0"
  },
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "test": "jest",
    "prepublishOnly": "npm run build && npm test"
  }
}
